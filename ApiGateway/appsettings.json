{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "GrpcHost": "localhost",
    "GrpcPort": 50053,
    "SignalRHost": "localhost",
    "SignalRPort": 5164,
    "SignalRHubs": [
      "Job", "Notification", "Auth", "Notify"
    ],
    "SignalRListeners": {
      "Job": "Create",
      "Notification": "Success",
      "Auth": "Login"
    }
  }
}
