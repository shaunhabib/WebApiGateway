{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "GrpcHost": "localhost",
    "GrpcPort": 50053,
    "SignalRHost": "localhost",
    "SignalRPort": 5164,
    "SignalRHubs": [
      "Job",
      "Notification",
      "Auth",
      "Notify",
      "PEPJob",
      "POC",
      "PEPNotification"
    ],
    "SignalRListeners": {
      "Job": "Success",
      "Auth": "Login",
      "PEPJob": "PEPJobCreate",
      "POC": "Action",
      "PEPNotification": "PEPResponse"
    }
  }
}
